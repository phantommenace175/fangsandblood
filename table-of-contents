
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Nocturne Archive | Directory</title>

  <style>
    * {
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      padding: 40px 20px;
      background:
        radial-gradient(ellipse at top, #201927, #0a090e 65%);
      color: #e4deeb;
      font-family: Georgia, "Times New Roman", serif;
      text-align: center;
      min-height: 100vh;
    }

    a {
      -webkit-tap-highlight-color: transparent;
    }

    .top {
      color: #a998bd;
      font-size: 10px;
      letter-spacing: 5px;
    }

    h1 {
      font-size: clamp(32px, 8vw, 50px);
      font-weight: normal;
      letter-spacing: 3px;
      margin: 28px 0 12px;
    }

    h2 {
      font-size: 23px;
      font-weight: normal;
      letter-spacing: 2px;
    }

    .intro {
      color: #9991a4;
      font-size: 13px;
      line-height: 2;
    }

    .ornament {
      color: #a998bd;
      margin: 28px auto;
      letter-spacing: 8px;
    }

    .contents {
      max-width: 460px;
      margin: 35px auto;
      padding: 25px 20px;
      background: #100e15;
      border: 1px solid #39303f;
      text-align: left;
      box-shadow: 0 10px 35px #00000030;
    }

    .contents h2,
    .contents .intro {
      text-align: center;
    }

    .contents a {
      display: block;
      padding: 16px 8px;
      border-bottom: 1px solid #302737;
      color: #ded4e8;
      text-decoration: none;
      font-size: 14px;
      transition: 0.3s;
    }

    .contents a:last-child {
      border-bottom: none;
    }

    .contents a:hover {
      padding-left: 16px;
      background: #1a1520;
    }

    .number {
      color: #a998bd;
      margin-right: 12px;
      font-size: 11px;
      letter-spacing: 1px;
    }

    .section {
      max-width: 460px;
      margin: 35px auto;
      padding: 30px 22px;
      border: 1px solid #302737;
      background: #100e15aa;
      scroll-margin-top: 20px;
    }

    .section p {
      color: #aaa2b4;
      font-size: 13px;
      line-height: 2;
    }

    .label {
      color: #a998bd;
      font-size: 10px;
      letter-spacing: 4px;
    }

    .social {
      display: inline-block;
      margin-top: 12px;
      padding: 12px 20px;
      border: 1px solid #665473;
      color: #ded4e8;
      text-decoration: none;
      font-size: 11px;
      letter-spacing: 2px;
    }

    .social:hover {
      background: #211a29;
    }

    .back {
      display: inline-block;
      margin: 25px 0;
      color: #b9a6cc;
      text-decoration: none;
      font-size: 11px;
      letter-spacing: 2px;
    }

    footer {
      margin-top: 35px;
      padding: 20px 0;
      color: #605968;
      font-size: 9px;
      letter-spacing: 3px;
      line-height: 2;
    }
  </style>
</head>

